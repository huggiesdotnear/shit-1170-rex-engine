# =====================
# bind host (default 0.0.0.0)
SHIT_1170_HOST=0.0.0.0
# bind port (default 54733)
SHIT_1170_PORT=54733
# =====================


# =====================
# there is NO rpc url here.
#
# the backend reads the chain for ONE thing: checking that a key an
# agent wants to remove really IS a limited key on the account it
# names. the key's permission lives on chain, and only the chain knows
# it.
#
# it reads the chain through near-kit, the same toolkit the browser
# reads it through, and near-kit carries the rpc url for each network
# with the network itself. so there is nothing to configure and nothing
# to get wrong.
# =====================


# =====================
# cloudflare tunnel token.
#
# SECRET — never commit a real token. copy this file to `.env` and
# paste your tunnel token there; `.env` is gitignored.
#
# where to get it: cloudflare dashboard > Zero Trust > Networks >
# Tunnels > your tunnel > the docker install command shows
#   --token <THIS VALUE>
#
# the variable is named TUNNEL_TOKEN (not CLOUDFLARE_TUNNEL_TOKEN)
# because that is the name cloudflared itself reads from the
# environment, and docker-compose.yml hands this file to it verbatim
# via env_file. renaming it here would mean the container starts with
# an empty token.
# =====================
TUNNEL_TOKEN=
# =====================